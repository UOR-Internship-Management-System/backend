diff --git a/src/main/java/lk/ac/ruhuna/dcs/cvmanagement/infrastructure/latex/LatexCvRenderer.java b/src/main/java/lk/ac/ruhuna/dcs/cvmanagement/infrastructure/latex/LatexCvRenderer.java
