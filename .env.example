CV_DB_NAME=cv_management
CV_DB_USERNAME=cv_user
CV_DB_PASSWORD=cv_local_password
CV_DB_PORT=5432

SPRING_PROFILES_ACTIVE=local
JWT_SECRET=change-this-local-development-secret-at-least-32-characters
JWT_ISSUER=cv-management-local
JWT_ACCESS_TOKEN_TTL=PT30M
JWT_REFRESH_TOKEN_TTL=P7D

FRONTEND_ORIGIN=http://localhost:5173

# Academic Ledger source-file storage
ACADEMIC_LEDGER_STORAGE_ROOT=./data/academic-ledger
ACADEMIC_LEDGER_MAX_FILE_SIZE_BYTES=5242880
ACADEMIC_LEDGER_RETRY_AFTER_SECONDS=2

# Generated CV PDF storage and XeLaTeX runtime
CV_STORAGE_ROOT=./data/cv
CV_LATEX_COMMAND=xelatex
CV_LATEX_TIMEOUT=PT10S
CV_PDF_MAX_BYTES=5242880
CV_PDF_MAX_CONCURRENT=2
CV_PREVIEW_TTL=PT15M
CV_CONSUMED_PREVIEW_RETENTION=PT24H
CV_CLEANUP_POLL_DELAY_MS=60000
CV_ORPHAN_GRACE_PERIOD=PT1H
