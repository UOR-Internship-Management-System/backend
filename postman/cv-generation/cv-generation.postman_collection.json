    {
      "name": "02 - First Preview and Save",
      "item": [
        {
          "name": "01 Generate real staged preview",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me/cv/preview",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me",
                "cv",
                "preview"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"includedExperienceIds\":[],\"includedProjectIds\":[],\"includedCertificateIds\":[],\"includedAwardIds\":[],\"includedActivityIds\":[]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Preview returns 200', () => pm.response.to.have.status(200));",
                  "const b=pm.response.json(); pm.expect(b.previewId).to.be.a('string'); pm.expect(b.htmlPreview).to.be.a('string').and.not.empty; pm.expect(b).to.not.have.property('latexSource'); pm.expect(new Date(b.expiresAt).getTime()).to.be.above(new Date(b.generatedAt).getTime()); pm.collectionVariables.set('previewId', b.previewId);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Save without precondition is 428",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me/cv",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me",
                "cv"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"previewId\":\"{{previewId}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing precondition returns 428', () => { pm.response.to.have.status(428); pm.expect(pm.response.json().code).to.eql('PRECONDITION_REQUIRED'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "03 First save with If-None-Match star",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "If-None-Match",
                "value": "*"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me/cv",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me",
                "cv"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"previewId\":\"{{previewId}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('First save returns 201', () => pm.response.to.have.status(201));",
                  "const b=pm.response.json(); pm.expect(b.revision).to.eql(1); pm.expect(b.downloadUrl).to.eql('/me/cv/download'); pm.expect(b.pdfFile.mediaType).to.eql('application/pdf'); pm.expect(b.pdfFile.fileSizeBytes).to.be.above(0); pm.expect(pm.response.headers.get('ETag')).to.eql('\\\"1\\\"'); pm.collectionVariables.set('cvId', b.cvId); pm.collectionVariables.set('cvRevision', String(b.revision));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Same preview retry is idempotent",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "If-None-Match",
                "value": "*"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me/cv",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me",
                "cv"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"previewId\":\"{{previewId}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Consumed preview retry does not increment revision', () => { pm.response.to.have.status(201); const b=pm.response.json(); pm.expect(b.cvId).to.eql(pm.collectionVariables.get('cvId')); pm.expect(b.revision).to.eql(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Current CV returns same ETag",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me/cv",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me",
                "cv"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Current CV returns revision 1 and ETag', () => { pm.response.to.have.status(200); const b=pm.response.json(); pm.expect(b.revision).to.eql(1); pm.expect(pm.response.headers.get('ETag')).to.eql('\\\"1\\\"'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Student downloads persisted PDF",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me/cv/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me",
                "cv",
                "download"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('PDF download headers and signature are safe', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'); pm.expect(pm.response.headers.get('Content-Disposition')).to.match(/^attachment;/); pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'); pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'); pm.expect(pm.response.text().slice(0,5)).to.eql('%PDF-'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Freshness, Stale Preview, Replacement",
      "item": [
        {
          "name": "01 Generate preview that will become stale",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me/cv/preview",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me",
                "cv",
                "preview"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"includedExperienceIds\":[],\"includedProjectIds\":[],\"includedCertificateIds\":[],\"includedAwardIds\":[],\"includedActivityIds\":[]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Stale candidate preview created', () => { pm.response.to.have.status(200); pm.collectionVariables.set('stalePreviewId', pm.response.json().previewId); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Mutate rendered Profile source",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "If-Match",
                "value": "\"{{profileVersion}}\""
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me",
                "profile"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"summary\":\"BMD-007 acceptance freshness probe {{runId}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(!pm.collectionVariables.get('runId')) pm.collectionVariables.set('runId', String(Date.now()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile mutation returns 200', () => pm.response.to.have.status(200)); const b=pm.response.json(); pm.collectionVariables.set('mutatedProfileVersion', String(b.version));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Freshness becomes OUTDATED PROFILE",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me/cv/source-freshness",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me",
                "cv",
                "source-freshness"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile mutation makes saved CV outdated', () => { pm.response.to.have.status(200); const b=pm.response.json(); pm.expect(b.status).to.eql('OUTDATED'); pm.expect(b.changedAreas).to.include('PROFILE'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Saving stale preview returns 409",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "If-Match",
                "value": "\"{{cvRevision}}\""
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me/cv",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me",
