{
  "info": {
    "_postman_id": "ee4035a8-9b30-41c8-82b8-292b0d52aa2f",
    "name": "CV Management - BMD-007 CV Generation Acceptance",
    "description": "Live BMD-007 release acceptance against Spring Boot + PostgreSQL + real XeLaTeX. Use a dedicated Student whose active CV state has been reset before the run. The suite validates contract, preview generation, first save, idempotency, PDF download, freshness, stale preview, ETag replacement, profile restoration and Admin read-only latest-CV access.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Authentication",
      "item": [
        {
          "name": "01 Student login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/student/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "student",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{studentEmail}}\",\"password\":\"{{studentPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "['studentToken','adminToken','studentId','previewId','stalePreviewId','cvId','cvRevision','profileVersion','originalSummaryJson','mutatedProfileVersion'].forEach(k => pm.collectionVariables.unset(k));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Student login returns 200', () => pm.response.to.have.status(200));",
                  "const b=pm.response.json(); pm.expect(b.accessToken).to.be.a('string').and.not.empty; pm.expect(b.user.roles).to.include('STUDENT'); pm.collectionVariables.set('studentToken', b.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/admin/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "admin",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login returns 200', () => pm.response.to.have.status(200));",
                  "const b=pm.response.json(); pm.expect(b.accessToken).to.be.a('string').and.not.empty; pm.expect(b.user.roles).to.include('ADMIN'); pm.collectionVariables.set('adminToken', b.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Resolve Student profile identity",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me",
                "profile"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Student profile returns 200', () => pm.response.to.have.status(200));",
                  "const b=pm.response.json(); pm.collectionVariables.set('studentId', b.studentId); pm.collectionVariables.set('profileVersion', String(b.version)); pm.collectionVariables.set('originalSummaryJson', JSON.stringify(b.summary));"
                ]
              }
            }
          ]
        }
      ]
    },
