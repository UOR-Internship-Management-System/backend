{
  "info": {
    "_postman_id": "2d0e6417-6bc4-4f47-90d6-a3ef90856a52",
    "name": "Admin Student Inspection Acceptance",
    "description": "Live Patch 6 acceptance for BMD-008. Credentials and generated tokens must remain in the ignored local environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/admin/login", "host": ["{{baseUrl}}"], "path": ["auth", "admin", "login"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Admin login succeeds', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
            "pm.environment.set('accessToken', body.accessToken);"
          ] } }]
        },
        {
          "name": "Student login for negative authorization",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/student/login", "host": ["{{baseUrl}}"], "path": ["auth", "student", "login"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Student login succeeds', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
            "pm.environment.set('studentAccessToken', body.accessToken);"
          ] } }]
        }
      ]
    },
    {
      "name": "Roster",
      "item": [
        {
          "name": "Default registered Student page",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/students", "host": ["{{baseUrl}}"], "path": ["admin", "students"] } },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Roster returns 200 JSON', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });",
            "const body = pm.response.json(); pm.expect(body.content).to.be.an('array'); pm.expect(body.page).to.be.an('object');",
            "pm.expect(JSON.stringify(body)).not.to.include('password'); pm.expect(JSON.stringify(body)).not.to.include('reviewStatus');"
          ] } }]
        },
        {
          "name": "Search name index and batch literal",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/students?search={{searchName}}&size=100&sort=indexNumber%2Casc", "host": ["{{baseUrl}}"], "path": ["admin", "students"], "query": [{ "key": "search", "value": "{{searchName}}" }, { "key": "size", "value": "100" }, { "key": "sort", "value": "indexNumber,asc" }] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Bounded roster search succeeds', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().page.size).to.eql(100);"] } }]
        },
        {
          "name": "Level and GPA sorting",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/students?level=3&sort=officialGpa%2Cdesc", "host": ["{{baseUrl}}"], "path": ["admin", "students"], "query": [{ "key": "level", "value": "3" }, { "key": "sort", "value": "officialGpa,desc" }] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Approved level and sort succeed', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Invalid roster controls",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/students?page=-1&size=101&level=9&sort=unsafe", "host": ["{{baseUrl}}"], "path": ["admin", "students"], "query": [{ "key": "page", "value": "-1" }, { "key": "size", "value": "101" }, { "key": "level", "value": "9" }, { "key": "sort", "value": "unsafe" }] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Invalid roster controls return 400', () => pm.response.to.have.status(400));", "pm.expect(pm.response.json().code).to.be.a('string');"] } }]
        }
      ]
    },
    {
      "name": "Student deep-dive and collections",
      "item": [
        {
          "name": "Populated registered Student",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/students/{{registeredStudentId}}", "host": ["{{baseUrl}}"], "path": ["admin", "students", "{{registeredStudentId}}"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Deep-dive succeeds', () => pm.response.to.have.status(200));", "const b=pm.response.json(); pm.expect(b.student.studentId).to.eql(pm.environment.get('registeredStudentId')); pm.expect(b.cvSupportingData).to.be.an('object'); pm.expect(b.latestCv).to.be.an('object');"] } }]
        },
        {
          "name": "Registered Student without profile",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/students/{{emptyStudentId}}", "host": ["{{baseUrl}}"], "path": ["admin", "students", "{{emptyStudentId}}"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Synthetic read-only profile succeeds', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().profile.version).to.eql(0);"] } }]
        },
        {
          "name": "Unknown Student",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/students/{{unknownStudentId}}", "host": ["{{baseUrl}}"], "path": ["admin", "students", "{{unknownStudentId}}"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Unknown Student returns 404', () => pm.response.to.have.status(404));", "pm.expect(pm.response.json().code).to.eql('REGISTERED_STUDENT_NOT_FOUND');"] } }]
        },
        {
          "name": "Malformed Student UUID",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/students/not-a-uuid", "host": ["{{baseUrl}}"], "path": ["admin", "students", "not-a-uuid"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Malformed UUID returns 400', () => pm.response.to.have.status(400));", "pm.expect(pm.response.json().code).to.eql('VALIDATION_FAILED');"] } }]
        },
        {
          "name": "Declared skills populated/search",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/students/{{registeredStudentId}}/declared-skills?search={{skillSearch}}", "host": ["{{baseUrl}}"], "path": ["admin", "students", "{{registeredStudentId}}", "declared-skills"], "query": [{ "key": "search", "value": "{{skillSearch}}" }] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Declared skills return a page', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().content).to.be.an('array');"] } }]
        },
        {
          "name": "Projects with linked skills/search",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/students/{{registeredStudentId}}/projects?search={{projectSearch}}", "host": ["{{baseUrl}}"], "path": ["admin", "students", "{{registeredStudentId}}", "projects"], "query": [{ "key": "search", "value": "{{projectSearch}}" }] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Projects return a page', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().content).to.be.an('array');"] } }]
        },
        {
          "name": "Official academic records/filter/sort",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/students/{{registeredStudentId}}/academic-records?courseCode={{courseCode}}&sort=courseCode%2Casc", "host": ["{{baseUrl}}"], "path": ["admin", "students", "{{registeredStudentId}}", "academic-records"], "query": [{ "key": "courseCode", "value": "{{courseCode}}" }, { "key": "sort", "value": "courseCode,asc" }] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Academic records return a page', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().content).to.be.an('array');"] } }]
        },
        {
          "name": "Invalid academic course code",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/students/{{registeredStudentId}}/academic-records?courseCode=CSC%201213", "host": ["{{baseUrl}}"], "path": ["admin", "students", "{{registeredStudentId}}", "academic-records"], "query": [{ "key": "courseCode", "value": "CSC 1213" }] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Invalid course code returns 400', () => pm.response.to.have.status(400));", "pm.expect(pm.response.json().code).to.be.a('string');"] } }]
        }
      ]
    },
    {
      "name": "Latest saved CV",
      "item": [
        {
          "name": "Available current CV metadata",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/students/{{registeredStudentId}}/latest-cv", "host": ["{{baseUrl}}"], "path": ["admin", "students", "{{registeredStudentId}}", "latest-cv"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Current CV metadata is available', () => pm.response.to.have.status(200));", "const b=pm.response.json(); pm.expect(b.availability).to.eql('AVAILABLE'); pm.expect(b.freshnessStatus).to.eql('CURRENT'); pm.expect(b.downloadUrl).to.be.a('string');"] } }]
        },
        {
          "name": "Available outdated CV metadata",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/students/{{outdatedCvStudentId}}/latest-cv", "host": ["{{baseUrl}}"], "path": ["admin", "students", "{{outdatedCvStudentId}}", "latest-cv"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Outdated CV metadata is available', () => pm.response.to.have.status(200));", "const b=pm.response.json(); pm.expect(b.availability).to.eql('AVAILABLE'); pm.expect(b.freshnessStatus).to.eql('OUTDATED');"] } }]
        },
        {
          "name": "No saved CV metadata",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/students/{{notSavedStudentId}}/latest-cv", "host": ["{{baseUrl}}"], "path": ["admin", "students", "{{notSavedStudentId}}", "latest-cv"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Not-saved metadata returns clean 200 state', () => pm.response.to.have.status(200));", "const b=pm.response.json(); pm.expect(b.availability).to.eql('NOT_SAVED'); pm.expect(b.cvId).to.eql(null); pm.expect(b.downloadUrl).to.eql(null);"] } }]
        },
        {
          "name": "Download current PDF",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/students/{{registeredStudentId}}/latest-cv/download", "host": ["{{baseUrl}}"], "path": ["admin", "students", "{{registeredStudentId}}", "latest-cv", "download"] } },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('PDF download succeeds', () => pm.response.to.have.status(200));",
            "pm.test('PDF headers are safe', () => { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'); pm.expect(pm.response.headers.get('Content-Disposition')).to.match(/^attachment;/); pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'); pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'); });",
            "pm.test('PDF body is non-empty', () => pm.expect(pm.response.stream.byteLength).to.be.above(4));"
          ] } }]
        },
        {
          "name": "Download when no saved CV exists",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/students/{{notSavedStudentId}}/latest-cv/download", "host": ["{{baseUrl}}"], "path": ["admin", "students", "{{notSavedStudentId}}", "latest-cv", "download"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Missing saved CV returns 404', () => pm.response.to.have.status(404));", "pm.expect(pm.response.json().code).to.eql('CV_NOT_SAVED');"] } }]
        }
      ]
    },
    {
      "name": "Security",
      "item": [
        {
          "name": "Anonymous Admin Student request",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/admin/students/{{registeredStudentId}}", "host": ["{{baseUrl}}"], "path": ["admin", "students", "{{registeredStudentId}}"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Anonymous request returns 401', () => pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "Student role Admin Student request",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{studentAccessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/students/{{registeredStudentId}}/latest-cv", "host": ["{{baseUrl}}"], "path": ["admin", "students", "{{registeredStudentId}}", "latest-cv"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Student role returns 403', () => pm.response.to.have.status(403));"] } }]
        },
        {
          "name": "Invalid token Admin Student request",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer invalid.invalid.invalid" }], "url": { "raw": "{{baseUrl}}/admin/students", "host": ["{{baseUrl}}"], "path": ["admin", "students"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Invalid token returns 401', () => pm.response.to.have.status(401));"] } }]
        }
      ]
    }
  ]
}
