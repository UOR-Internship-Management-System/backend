# Production environment variables (Railway).
# Set each of these in Railway → your backend service → Variables.
# Do NOT commit a real .env.production file — this is a template only.

SPRING_PROFILES_ACTIVE=prod

# --- Database ---
# Railway's Postgres plugin exposes its own DATABASE_URL in JDBC form already;
# if it gives you a postgres:// URL instead, convert it to:
# jdbc:postgresql://<host>:<port>/<database>
DATABASE_URL=jdbc:postgresql://<host>:<port>/<database>
DATABASE_USERNAME=<db-username>
DATABASE_PASSWORD=<db-password>

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=<random-secret-at-least-32-characters>
JWT_ISSUER=cv-management-prod

# --- CORS ---
# Your deployed frontend URL(s), comma-separated if more than one (e.g. prod + a preview URL)
FRONTEND_ORIGIN=https://your-app.vercel.app

# --- Files / public URLs ---
# The public URL of THIS backend service (Railway gives you one like the example below)
PUBLIC_BASE_URL=https://your-backend.up.railway.app

# --- Email (OTP delivery, notifications) ---
APP_EMAIL_MODE=smtp
APP_EMAIL_FROM=no-reply@your-domain.com
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>

# --- CV PDF generation storage ---
# These default to ./data/cv and ./data/academic-ledger (relative to the container's
# working directory) if unset. IMPORTANT: Railway's filesystem is ephemeral — anything
# written here is wiped on every redeploy/restart. Attach a Railway Volume mounted at
# /app/data and set these to point inside it, or generated CVs and uploaded ledger
# files will disappear after the next deploy:
# CV_STORAGE_ROOT=/app/data/cv
# ACADEMIC_LEDGER_STORAGE_ROOT=/app/data/academic-ledger
